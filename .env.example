# Copy this file to .env and fill in real values. NEVER commit .env to git.

# App
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000            # production: https://musafir.siddheshgupta.com (used in email links)

# Database (local dev -> 127.0.0.1; on AWS -> your RDS endpoint)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=musafir

# Admin panel login
ADMIN_USER=admin
ADMIN_PASS=admin123

# Email — ZeptoMail SMTP (leave blank = DEV mode: emails are printed to the console, not sent)
# Later swap to Amazon SES by changing only these values.
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=
MAIL_FROM="Musafir <noreply@musafir.siddheshgupta.com>"

# Payments — Razorpay test mode (leave blank = simulate mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Phase 4
OPENWEATHER_API_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
