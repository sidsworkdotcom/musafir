<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Log in · Musafir</title>
</head>
<body>
  <%- include('../partials/header') %>
  <section class="auth-wrap">
    <%- include('_side') %>
    <div class="auth-main">
      <p class="mono">WELCOME BACK</p>
      <h1>Log in</h1>
      <% if (error) { %>
        <p class="form-error"><%= error %>
          <% if (unverified) { %>
            <form class="auth-inline" method="post" action="/resend-verification"><input type="hidden" name="email" value="<%= unverified %>"><button type="submit">Resend the link</button></form>
          <% } %>
        </p>
      <% } %>
      <form method="post" action="/login">
        <label>Email <input type="email" name="email" value="<%= form.email || '' %>" required autofocus autocomplete="email"></label>
        <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
        <p class="auth-row"><span></span><a href="/forgot">Forgot password?</a></p>
        <button type="submit">Log in →</button>
      </form>
      <p class="auth-switch">New here? <a href="/signup">Create an account</a></p>
    </div>
  </section>
  <%- include('../partials/footer') %>
</body>
</html>
