<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Musafir · Trips across India, booked in minutes</title>
</head>
<body>
  <%- include('partials/header') %>

  <section class="hero">
    <svg class="hero-map" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs><pattern id="dots" width="26" height="26" patternUnits="userSpaceOnUse"><circle cx="1.2" cy="1.2" r="1.2" fill="#3a4160"/></pattern></defs>
      <rect width="1200" height="420" fill="url(#dots)"/>
      <path d="M80 340 C 300 120, 520 380, 760 160 S 1120 90, 1180 40" fill="none" stroke="#12727d" stroke-width="2" stroke-dasharray="4 8"/>
      <g fill="#f4a300"><circle cx="80" cy="340" r="5"/><circle cx="410" cy="252" r="5"/><circle cx="760" cy="160" r="5"/><circle cx="1180" cy="40" r="5"/></g>
      <text x="96" y="332" fill="#a9b0cc" font-family="monospace" font-size="11" letter-spacing="2">MUMBAI</text>
      <text x="426" y="244" fill="#a9b0cc" font-family="monospace" font-size="11" letter-spacing="2">GOA</text>
      <text x="776" y="152" fill="#a9b0cc" font-family="monospace" font-size="11" letter-spacing="2">JAIPUR</text>
      <text x="1090" y="32" fill="#a9b0cc" font-family="monospace" font-size="11" letter-spacing="2">MANALI</text>
    </svg>
    <div class="hero-inner">
      <p class="eyebrow mono">PACKAGES · FLIGHTS · TRAINS · HOTELS</p>
      <h1>Har safar,<br><em>sorted</em>.</h1>
      <p class="hero-sub">Packages, flights, trains and hotels across India — one account, one checkout, live seat counts on everything. Pay, and your e-ticket lands in your inbox in seconds.</p>

      <div id="search"><%- include('partials/travel-search', { active: 'PACKAGE', q: {}, flightCities, trainCities, hotelCities, compact: false }) %></div>

      <div class="hero-stats">
        <div class="hero-stat"><strong><%= stats.trips %></strong><span>curated trips</span></div>
        <div class="hero-stat"><strong><%= stats.flights %></strong><span>daily flights</span></div>
        <div class="hero-stat"><strong><%= stats.trains %></strong><span>trains</span></div>
        <div class="hero-stat"><strong><%= stats.hotels %></strong><span>hotels</span></div>
        <div class="hero-stat"><strong>★ <%= stats.rating || '—' %></strong><span>from verified travellers</span></div>
        <div class="hero-stat"><strong>0%</strong><span>cancellation fee</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Departing soon</h2>
      <a class="mono see-all" href="/packages">ALL TRIPS →</a>
    </div>
    <div class="card-grid">
      <% featured.forEach(p => { %>
        <%- include('partials/package-card', { p }) %>
      <% }) %>
    </div>
  </section>

  <section class="section categories">
    <h2>Travel by mood</h2>
    <div class="chip-row">
      <% categories.forEach(c => { %>
        <a class="chip" href="/packages?category=<%= c %>"><%= c.charAt(0) + c.slice(1).toLowerCase() %></a>
      <% }) %>
    </div>
  </section>

  <section class="why">
    <div><span class="ico">📅</span><div><strong>Real departure dates</strong><span>Every trip shows live seat counts — no "enquire now" forms.</span></div></div>
    <div><span class="ico">🔒</span><div><strong>Secure payment</strong><span>Razorpay checkout, verified server-side. Cards, UPI, netbanking.</span></div></div>
    <div><span class="ico">★</span><div><strong>Verified reviews only</strong><span>Only travellers with a confirmed booking can rate a trip.</span></div></div>
    <div><span class="ico">✉</span><div><strong>Instant confirmation</strong><span>Booking reference and fare summary emailed the moment you pay.</span></div></div>
  </section>

  <%- include('partials/offer-popup') %>
  <%- include('partials/footer') %>
</body>
</html>
