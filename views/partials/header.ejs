<header class="site-header">
  <a href="/" class="brand">
    <img class="brand-logo" src="/img/logo-mark.png" alt=""> MUSAFIR <span class="brand-tag">HAR SAFAR, SORTED.</span>
  </a>
  <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span></button>
  <div class="nav-backdrop" data-nav-close></div>
  <nav id="site-nav">
    <a href="/packages">Packages</a>
    <a href="/flights">Flights</a>
    <a href="/trains">Trains</a>
    <a href="/hotels">Hotels</a>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/my-bookings">My bookings</a>
      <span class="nav-user">
        <a class="nav-account" href="/account" aria-label="My account"><span class="avatar" aria-hidden="true"><%= user.name.trim().charAt(0).toUpperCase() %></span></a>
        <a class="nav-account name" href="/account"><%= user.name.split(' ')[0] %></a>
        <form method="post" action="/logout" class="nav-logout"><button type="submit">Log out</button></form>
      </span>
    <% } else { %>
      <a href="/login">Log in</a>
      <a href="/signup" class="nav-admin nav-cta">Sign up</a>
    <% } %>
  </nav>
</header>
<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash"><p class="flash-<%= flash.type %>"><span><%= flash.text %></span><button type="button" data-dismiss aria-label="Dismiss">×</button></p></div>
<% } %>
